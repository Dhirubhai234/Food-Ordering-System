# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_ADDRESS/FoodOrderingSystem?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Optional: Initial Admin Seed Credentials (used only by npm run seed:admin)
# ADMIN_NAME=System Administrator
# ADMIN_EMAIL=admin@foodie.com
# ADMIN_PASSWORD=your_secure_admin_password
# ADMIN_PHONE=9876543210
